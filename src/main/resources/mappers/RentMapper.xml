<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssg.martgowmsfullstack.mapper.RentMapper">
    <resultMap id="SectorDTOResultMap" type="com.ssg.martgowmsfullstack.dto.SectorDTO">
        <result property="sectorId" column="sector_id"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="height" column="height"/>
        <result property="width" column="width"/>
        <result property="FAR" column="FAR"/>
        <result property="status" column="status"/>
    </resultMap>
    <resultMap id="RentHistoryDTOResultMap" type="com.ssg.martgowmsfullstack.dto.RentHistoryDTO">
        <result property="rentNum" column="rent_num"/>
        <result property="sectorId" column="sector_id"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="userId" column="user_id"/>
        <result property="rentStartDate" column="rent_start_date"/>
        <result property="rentEndDate" column="rent_end_date"/>
        <result property="rentPrice" column="rent_price"/>
        <result property="approveDate" column="approve_date"/>
        <result property="status" column="status"/>
        <result property="adminId" column="admin_id"/>
    </resultMap>
    <resultMap id="WarehouseDTOResultMap" type="com.ssg.martgowmsfullstack.dto.WarehouseDTO">
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="location" column="location"/>
        <result property="height" column="height"/>
        <result property="width" column="width"/>
        <result property="FAR" column="FAR"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="getAllWarehouses" resultMap="WarehouseDTOResultMap">
        CALL GetAllWarehouses()
    </select>

    <select id="getSectorStatus" parameterType="int" resultType="String">
        CALL getSectorStatus(#{warehouseId})
    </select>

    <select id="getAllSectors" parameterType="int" resultMap="SectorDTOResultMap" statementType="CALLABLE">
        CALL GetAllSectors(#{warehouseId})
    </select>


    <select id="getCostInfo" resultType="com.ssg.martgowmsfullstack.dto.CostInfoDTO">
        CALL GetCostInfoSector(#{warehouseId}, #{sectorId})
    </select>

    <select id="getRentPrice" resultType="int">
        CALL GetCostInfo(#{warehouseId}, #{sectorId}, #{month})
    </select>

    <insert id="saveDb" parameterType="com.ssg.martgowmsfullstack.domain.RentHistoryVO">
        CALL InsertRentHistory(
                #{sectorId},
                #{warehouseId},
                #{rentStartDate,jdbcType=DATE},
                #{rentEndDate,jdbcType=DATE},
                #{rentPrice},
                #{userId}
             )
    </insert>

    <select id="getHoldRentHistory" resultMap="RentHistoryDTOResultMap">
        CALL GetHoldRentHistory(#{adminId})
    </select>

    <update id="updateUserAdminId">
        CALL updateUserAdminid()
    </update>

    <update id="updateAdminId">
        CALL UpdateAdminId(#{rentNum}, #{adminId})
    </update>

    <select id="getInProgressRentHistory" resultMap="RentHistoryDTOResultMap">
        CALL GetInProgressRentHistory(#{adminId})
    </select>

    <update id="completedRentStatus">
        CALL CompletedRentStatus(#{rentNum}, #{adminId})
    </update>

</mapper>
